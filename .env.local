# Aaditech UFO — Local Development Environment
# Copy this to .env: cp .env.local .env
# Then run: make up
#
# DO NOT commit .env to git (it is in .gitignore)

# === DATABASE (Docker Postgres) ===
DATABASE_URL=postgresql://aaditech:admin123@localhost:5432/aaditech_ufo
DB_USER=aaditech
DB_PASSWORD=admin123
DB_NAME=aaditech_ufo

# === REDIS (Docker) ===
REDIS_URL=redis://:redis123@localhost:6379/0
REDIS_PASSWORD=redis123
RATELIMIT_STORAGE_URL=redis://:redis123@localhost:6379/0

# === FLASK ===
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=local-dev-secret-CHANGE-IN-PROD
HOST=0.0.0.0
PORT=5000

# === AUTH / JWT ===
JWT_SECRET_KEY=local-dev-jwt-secret-CHANGE-IN-PROD
ACCESS_TOKEN_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=7

# === AGENT ===
AGENT_API_KEY=local-dev-agent-key-CHANGE-IN-PROD
AGENT_RELEASES_DIR=agent_releases
AGENT_RELEASE_MAX_MB=256

# === AI / OLLAMA (optional — disable for local dev) ===
OLLAMA_ADAPTER=linux_test_double
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=8

# === AGENT ENGINE ===
AGENT_ENGINE_ENABLED=True
AGENT_ENGINE_MAX_STEPS=10
AGENT_ENGINE_MAX_RETRIES=2
AGENT_ENGINE_STEP_TIMEOUT_SECONDS=30

# === AUTOMATION / REMOTE EXEC ===
AUTOMATION_EXECUTOR_ADAPTER=linux_test_double
REMOTE_EXEC_ADAPTER=linux_test_double
SELF_HEALING_DRY_RUN=true

# === LOGGING ===
LOG_LEVEL=DEBUG

# === NGINX GATEWAY (optional) ===
NGINX_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# === SEED ADMIN (used by scripts/seed_default_admin.py) ===
SEED_ADMIN_TENANT=default
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
